## Wallets
# Prefer 30 wallets, comma-separated. You can also use PRIVATE_KEY for single wallet.
PRIVATE_KEYS=0xabc...,0xdef...
# PRIVATE_KEY=0xabc...

## Pool selection
POOL_INDEX=0

## Optional overrides
# RPC_URL=https://...
ETH_USD=3000
WALLET_COUNT=30
MAX_CONSECUTIVE_PER_WALLET=5
MAX_CONSECUTIVE_SAME_SIDE=4

## Safety
DRY_RUN=true

## Optional overrides for scripts/read-v3-price.ts
RPC_URL=https://eth-sepolia.api.onfinality.io/public
POOL=0xc7948fC7Aba1b56AdC035e1ae53816cD47dd33c7

